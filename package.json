{
  "name": "orbit-to-focus",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node tools/artifact.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vite build --mode e2e --outDir dist-e2e && playwright test",
    "data": "node tools/prep-data.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.3.3",
    "topojson-client": "3.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "3.2.7"
  }
}
